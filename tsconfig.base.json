{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@frigate/api-client": ["packages/api-client/src/index.ts"],
      "@frigate/api-client/*": ["packages/api-client/src/*"],
      "@frigate/utils": ["packages/utils/src/index.ts"],
      "@frigate/utils/*": ["packages/utils/src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["packages", "apps"]
}
